# Configuración Cloud de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Configuración Cloudflare R2 (Object Storage para Radiografías)
R2_ACCOUNT_ID=tu-cloudflare-account-id
R2_BUCKET_NAME=dentalcare-rx-storage
R2_PUBLIC_DOMAIN=https://rx.tudominio.com

# Meta WhatsApp Cloud API (Opcional para recordatorios)
WHATSAPP_API_TOKEN=tu-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
